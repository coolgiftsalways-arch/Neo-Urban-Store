<IfModule mod_rewrite.c>
    RewriteEngine On

    # Don't rewrite existing files
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Don't rewrite existing directories
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # React Router fallback
    RewriteRule ^ /index.html [L]
</IfModule>